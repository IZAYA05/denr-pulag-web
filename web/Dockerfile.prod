FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install --include=optional --no-audit --no-fund

COPY . .

ARG NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:18000
ENV NEXT_PUBLIC_LARAVEL_API_URL=${NEXT_PUBLIC_LARAVEL_API_URL}
ENV NODE_ENV=production

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]